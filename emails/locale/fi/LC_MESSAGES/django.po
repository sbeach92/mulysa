#: emails/admin.py
msgid "Show browser version"
msgstr "Näytä selaimen versio"

#: emails/admin.py emails/templates/admin/send-email.html
msgid "Send now"
msgstr "Lähetä heti"

#: emails/admin.py
msgid "Send email"
msgstr "Lähetä email"

#: emails/models.py emails/templates/admin/send-email.html
msgid "Subject"
msgstr "Aihe"

#: emails/models.py
msgid "Descriptive subject for the email. Finnish / English both should be written here"
msgstr "Kuvaava aihe sähköpostille. Sekä suomen- että englanninkieliset versiot tulisi kirjoittaa tähän"

#: emails/models.py
msgid "Content"
msgstr "Sisältö"

#: emails/models.py
msgid "Content of the email. All emails will start with default 'View this message in browser' and end with 'You are receiving this message because') texts"
msgstr "Sähköpostin sisältö. Kaikki viestit alkavat 'Katsele viestiä selaimessa' ja loppuvat 'Sait tämän viestin koska' teksteillä"

#: emails/models.py
msgid "Creation date"
msgstr "Luontipäivä"

#: emails/models.py
msgid "Last modified datetime"
msgstr "Muokattu viimeksi päiväys"

#: emails/models.py
msgid "Datetime the message was sent"
msgstr "Viestin lähetyksen päiväys"

#: emails/templates/admin/send-email.html
msgid "Body"
msgstr "Sisältö"

#: emails/templates/admin/send-email.html
msgid "Cancel"
msgstr "Peruuta"

#: emails/templates/mail_content_and_post.html
#: emails/templates/mail_content_and_post.txt
#, python-format
msgid "You are receiving this email because you are registered member of %(SITENAME)s"
msgstr "Sait tämän viestin koska olet %(SITENAME)s:n jäsen"
